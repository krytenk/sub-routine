; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also a regular text file.

config_version=5

[application]

config/name="Sub-Routine"
config/description="PS1-Style Lo-Fi Survival Horror Indie Game in a Subterranean Server Labyrinth"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/output_latency=50
driver/output_latency=50

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.05, 1)

