[node name="EpilogueLabel" type="Label" parent="ScrollContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.85, 1)
theme_override_font_sizes/font_size = 10
text = "After the subterranean hoist collapsed forever behind her, Roxy Vance escaped the blinding Clinical Behavioral Sanatorium Wing, solved the One-Way Mirror & X-Ray Lightbox autopsy puzzle, and stepped through the Oak Double Doors into the haunted 1931 Vance Manor Estate.
With the Grandfather Clock disarmed, Julian's Secret Study uncovered, and the Serpent & Raven Crests united, the Grand Ballroom awaits...
Stay tuned for the Final Chapters: Sectors 19 & 20!"
